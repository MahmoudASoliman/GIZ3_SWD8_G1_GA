# Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# Supabase Configuration
# ============================================
# Get these from: Supabase Dashboard > Settings > API

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Project Reference ID (from URL)
SUPABASE_PROJECT_REF=xxxxxxxxxxxxx

# ============================================
# Firebase Configuration
# ============================================
# Get Firebase Server Key from: Firebase Console > Project Settings > Cloud Messaging

FIREBASE_SERVER_KEY=AAAAxxxxxxx...

# ============================================
# Notes
# ============================================
# 1. NEVER commit the actual .env file to git
# 2. Update lib/core/constants/api_constants.dart with SUPABASE_URL and SUPABASE_ANON_KEY
# 3. Add FIREBASE_SERVER_KEY to Supabase secrets:
#    supabase secrets set FIREBASE_SERVER_KEY=YOUR_KEY
# 4. Add SUPABASE_SERVICE_ROLE_KEY to database settings (see SUPABASE_SETUP.md)
